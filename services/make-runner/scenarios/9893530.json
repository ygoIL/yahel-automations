         "codeEditorJavascript": "const cn=String(input.cn||'').replace(/\\D/g,'');\nconst vr=(input.valueRanges||[]).map(x=>x.valueRange||x);\nconst tabOf=s=>String(s||'').replace(/!.*$/,'').replace(/^'|'$/g,'');\nconst order=input.order||[];\nvr.sort((a,b)=>order.indexOf(tabOf(a.range))-order.indexOf(tabOf(b.range)));\n// RULE (15/11/2026, כפילויות): מעדכנים את כל השורות של הלקוח בדוח המכר (אותו מספר לקוח, או אותו טלפון בלי מספר אחר). אם אין שורה עם המספר - לא נמצא, כמו קודם. Do not remove.\nconst l9=s=>{const d=String(s||'').replace(/\\D/g,'');return d.length>=9?d.slice(-9):'';};\nconst seen={},all=[];\nfor(const r of vr){const tab=tabOf(r.range);if(seen[tab])continue;seen[tab]=1;const rows=r.values||[];for(let i=1;i<rows.length;i++){const x=rows[i]||[];all.push({tab,row:i+1,g:String(x[6]||'').replace(/\\D/g,''),ph:l9(x[3])});}}\nconst hit=cn?all.filter(x=>x.g===cn):[];\nconst phs=new Set(hit.map(x=>x.ph).filter(Boolean));\nconst upd=all.filter(x=>hit.includes(x)||(phs.has(x.ph)&&(!x.g||x.g===cn)));\nconst A1=x=>\"'\"+x.tab.replace(/'/g,\"''\")+\"'!\";\nconst val=v=>v==null?'':String(v);\nconst body=(col,v)=>JSON.stringify({valueInputOption:'USER_ENTERED',data:upd.map(x=>({range:A1(x)+col+x.row,values:[[val(v)]]}))});\nif(hit.length){const f=hit[0];return {found:true,tab:f.tab,row:f.row,note:'תאריך ההתקנה עודכן בשיטס ✔️'+(upd.length>1?' (עודכנו '+upd.length+' שורות של הלקוח)':''),count:upd.length,ranges:upd.map(x=>A1(x)+'E'+x.row).join(', '),body_e:body('E',input.val_e),body_f:body('F',input.val_f)};}\nreturn {found:false,tab:'',row:0,note:'⚠️ לא מצאתי את הלקוח בשיטס (אולי נמחק או שהמספר השתנה) - צריך לעדכן את התאריך ידנית.',count:0,ranges:'',body_e:'',body_f:''};\n"
