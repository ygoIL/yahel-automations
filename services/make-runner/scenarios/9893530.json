     "codeEditorJavascript": "const HM=['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];\nconst DAYS=['ראשון','שני','שלישי','רביעי','חמישי','שישי','שבת'];\nconst SLOTS={8:'08:00-10:00',10:'10:00-12:00',12:'12:00-14:00',14:'14:00-16:00',16:'16:00-18:00',18:'18:00-20:00'};\nfunction nowIL(){return new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Jerusalem'}));}\nfunction pad(n){return String(n).padStart(2,'0');}\nfunction parseDateSlot(t,now){\n  let d=null,slot=null,m;\n  const today=new Date(now.getFullYear(),now.getMonth(),now.getDate());\n  m=t.match(/(\\d{1,2})\\s*[./]\\s*(\\d{1,2})(?:\\s*[./]\\s*(\\d{2,4}))?/);\n  if(m){\n    const day=+m[1],mon=+m[2];let y=m[3]?(+m[3]<100?2000+ +m[3]:+m[3]):today.getFullYear();\n    if(mon>=1&&mon<=12&&day>=1&&day<=31){d=new Date(y,mon-1,day); if(!m[3]&&d<today)d=new Date(y+1,mon-1,day);}\n    t=t.replace(m[0],' ');\n  } else if(/מחרתיים/.test(t)){d=new Date(today);d.setDate(d.getDate()+2);t=t.replace(/מחרתיים/,' ');}\n  else if(/מחר/.test(t)){d=new Date(today);d.setDate(d.getDate()+1);t=t.replace(/מחר/,' ');}\n  else if(/היום/.test(t)){d=new Date(today);t=t.replace(/היום/,' ');}\n  m=t.match(/(\\d{1,2})(?::\\d{2})?\\s*(?:-|–|—|עד|ל-?)\\s*(\\d{1,2})(?::\\d{2})?/);\n  if(m){let s=+m[1]; if(s<8)s+=12; if(SLOTS[s])slot=s; t=t.replace(m[0],' ');}\n  else { m=t.match(/(?:ב?שעה|מ-?)\\s*(\\d{1,2})(?::\\d{2})?/); if(m){let s=+m[1]; if(s<8)s+=12; if(s%2)s-=1; if(SLOTS[s])slot=s; t=t.replace(m[0],' ');} }\n  return {d,slot,rest:t};\n}\nfunction fmt(d,slot){\n  if(!d)return {};\n  const o={full_date:'יום '+DAYS[d.getDay()]+' '+d.getDate()+' '+HM[d.getMonth()]+' '+d.getFullYear(),\n    iso_date:d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()),\n    short_date:d.getDate()+'/'+(d.getMonth()+1)};\n  if(slot){o.slot=SLOTS[slot];o.short_slot=slot+'-'+(slot+2);}\n  return o;\n}\nconst now=nowIL();\nconst subj=String(input.subject||'');\nconst nums=subj.match(/\\d{5,9}/g)||[];