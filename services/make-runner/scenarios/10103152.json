     "dependencies": [],
     "codeEditorJavascript": "// RULE (Steve 10/11/2026): active-customers cleanup (this scenario) may run at most once every 14 days, even if one of us asks. No daily cleanup.\n// A continuation batch (offset > 0) on the same day as the last allowed run is allowed.\nconst last = String(input.last || '').trim().slice(0, 10);\nconst off = Number(input.offset || 0) || 0;\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jerusalem' }));\nconst pad = (n) => String(n).padStart(2, '0');\nconst today = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());\nlet allowed = false, days = null, next = '';\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(last)) { allowed = true; }\nelse {\n  const a = Date.UTC(+last.slice(0, 4), +last.slice(5, 7) - 1, +last.slice(8, 10));\n  const b = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());\n  days = Math.round((b - a) / 86400000);\n  const n = new Date(a + 14 * 86400000);\n  next = n.getUTCFullYear() + '-' + pad(n.getUTCMonth() + 1) + '-' + pad(n.getUTCDate());\n  allowed = days >= 14 || (days === 0 && off > 0);\n}\nconst store = (allowed && off === 0) ? today : (last || today);\nconst note = allowed ? '' : JSON.stringify({ blocked: true, message: 'ניקוי לקוחות פעילים חסום: מותר פעם בשבועיים (הוראת סטיב 10/11/2026). רץ לאחרונה ' + last + ', הריצה הבאה מותרת מ-' + next + '.', lastRun: last, nextAllowed: next, at: new Date().toISOString() });\nreturn { allowed, store, note, days, next };\n"
    },
    "module": "code:ExecuteCode",
    "version": 1,
    "parameters": {}
   },
