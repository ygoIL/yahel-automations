         "language": "javascript",
         "inputFormat": "editor",
         "dependencies": [],
         "codeEditorJavascript": "const norm=s=>String(s||'').replace(/[\\s‎‏]+/g,' ').trim();\nlet rows=input.rows||[];\nif(typeof rows==='string'){try{rows=JSON.parse(rows);}catch(e){rows=[];}}\nif(rows.length&&Array.isArray(rows[0])&&Array.isArray(rows[0][0]))rows=rows[0];\nrows=rows.filter(r=>Array.isArray(r)&&norm(r[0]));\nconst rep=norm(input.rep);\nlet m=rows.filter(r=>norm(r[0])===rep);\nif(!m.length&&rep){\n  const f=rep.split(' ')[0];\n  m=rows.filter(r=>{const a=norm(r[0]);return a===f||a.split(' ')[0]===f;});\n}\nconst toIntl=p=>{let d=String(p||'').replace(/\\D/g,'');if(d.startsWith('972'))return d;if(d.startsWith('0'))d=d.slice(1);return d?'972'+d:'';};\nconst withPhone=m.filter(r=>toIntl(r[1]).length>=11);\nconst found=withPhone.length===1;\nconst first=found?norm(withPhone[0][0]).split(' ')[0]:'';\nconst lines=[\n  (found?'היי '+first+', ':'')+'🙋 לקוח שלך רוצה להקדים את ההתקנה!',\n  '',\n  '👤 '+norm(input.cname)+(input.cnum?' (לקוח '+norm(input.cnum)+')':''),\n  '📱 '+norm(input.cphone),\n  '📅 מתואם כרגע: '+norm(input.date)+' '+norm(input.slot),\n  '',\n  'תתקשר אליו היום, תסגור איתו יום וחלון שעות, ותשלח לבוט:',\n  'הקדמה '+norm(input.cphone)+' ל-<תאריך> <שעות>',\n  '(למשל: הקדמה '+norm(input.cphone)+' ל-21/10 10-12)'\n];\nif(input.chat) lines.push('','💬 השיחה עם הלקוח: '+norm(input.chat));\nlet msg=lines.join('\\n');\nif(!found) msg='⚠️ לא מצאתי טלפון לנציג \"'+(rep||'לא רשום')+'\" בלשונית יעדים, אז ההתראה הגיעה אליך:\\n\\n'+msg;\nreturn {found,phone:found?toIntl(withPhone[0][1]):'972544604246',flow:found?'content20260930150123_063231':'content20261005084024_300716',message:msg,rep_matched:found?norm(withPhone[0][0]):''};\n"
