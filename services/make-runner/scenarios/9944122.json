     "codeEditorJavascript": "// inputs: custNum, at, text, prevCount, prevLast, prevHistory, rec (fields from 193282 search), ranges, reps\nconst norm = s => String(s || '').replace(/\\s+/g, ' ').trim();\nconst digits = s => String(s || '').replace(/\\D/g, '');\nconst pad = n => String(n).padStart(2, '0');\nconst fmt = new Intl.DateTimeFormat('en-GB', {timeZone: 'Asia/Jerusalem', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'});\nconst stamp = t => { const p = {}; for (const x of fmt.formatToParts(new Date(t))) p[x.type] = x.value; return p.day + '/' + p.month + ' ' + p.hour + ':' + p.minute; };\nconst custNum = digits(input.custNum);\nconst at = String(input.at || '');\nif (input.prevLast && at && new Date(at) <= new Date(input.prevLast)) return {action: 'skip'};\nconst count = (parseInt(input.prevCount, 10) || 0) + 1;\nlet hit = null;\nfor (const vr of (input.ranges || [])) {\n  const tab = String((vr.valueRange || {}).range || '').split('!')[0].replace(/^'|'$/g, '');\n  const vals = (vr.valueRange && vr.valueRange.values) || [];\n  for (let i = 1; i < vals.length; i++) {\n    const r = vals[i];\n    if (digits(r[9]) === custNum) hit = {tab, row: i + 1, name: norm(r[2]), phone: digits(r[3]).replace(/^972/, '').replace(/^0/, ''), rep: norm(r[0]), qty: parseInt(r[14], 10) || 0};\n  }\n}\nconst rec = input.rec || {};\nlet local9 = digits(rec.phone).replace(/^972/, '').replace(/^0/, '') || (hit ? hit.phone : '');\nconst name = norm(rec.custName) || (hit ? hit.name : '') || 'לקוח';\nconst ALIAS = {'אוסי': 'אוסי גיאן', 'עמית אראל': 'עמית הראל', 'אופק פ': 'אופק'};\nlet repRows = input.reps || [];\nif (repRows.length && repRows[0] && repRows[0].valueRange) repRows = repRows[0].valueRange.values || [];\nconst reps = [];\nfor (const r of repRows.slice(1)) { const n = norm(r[0]); let p = digits(r[1]).replace(/^972/, '').replace(/^0/, ''); if (n && /^5\\d{8}$/.test(p)) reps.push({name: n, wa: '972' + p}); }\nfunction findRep(raw) {\n  let n = norm(raw); if (!n) return null; if (ALIAS[n]) n = ALIAS[n];\n  let h = reps.find(r => r.name === n); if (h) return h;\n  const f = reps.filter(r => r.name.split(' ')[0] === n.split(' ')[0]); return f.length === 1 ? f[0] : null;\n}\nlet repWa = digits(rec.repWa), repName = norm(rec.repName);\nif (!/^9725\\d{8}$/.test(repWa) && hit) { const r = findRep(hit.rep); if (r) { repWa = r.wa; repName = r.name; } else repName = hit.rep; }\nlet toYarden = false;\nif (!/^9725\\d{8}$/.test(repWa)) { repWa = '972544604246'; toYarden = true; }\nconst phone = local9 ? '0' + local9 : '';\nconst wa = local9 ? '972' + local9 : '';\nlet action;\nif (!phone) action = 'nophone';\nelse if (count <= 3) action = 'first';\nelse action = 'again';\nconst who = '👤 ' + name + ' (לקוח ' + custNum + ')' + (phone ? '\\n📞 ' + phone : '') + (hit && hit.qty > 1 ? '\\n📱 ' + hit.qty + ' קווים' : '');\nlet msg;\nif (action === 'first') msg = '📵 פלאפון ניסו להשיג את הלקוח לניוד ולא היה מענה' + (count > 1 ? ' (ניסיון ' + count + ' מתוך 3)' : '') + '\\n' + who + '\\n\\n✉️ שלחתי ללקוח הודעה לבחור מתי לחזור אליו - כשיבחר תקבל/י עדכון.\\n📧 מייל חדש לניודים יישלח רק באישור שלך: אחרי שתתאם/י שעה, שלח/י לבוט: ניוד ' + phone + ' <שעה>';\nelse if (action === 'again') msg = '📵 שוב ללא מענה מפלאפון (פעם ' + count + ')\\n' + who + '\\n\\n⚠️ הלקוח כבר קיבל 3 הודעות תיאום ולא ענה לפלאפון - לא שולח לו עוד. צריך לטפל ידנית: להתקשר אליו, לתאם שעה ולשלוח לבוט: ניוד ' + phone + ' <שעה>';\nelse msg = '📵 פלאפון כתבו \"ללא מענה\" על לקוח ' + custNum + ', אבל לא מצאתי אותו בדוח מכר פלאפון. צריך לטפל ידנית.';\nif (toYarden && action !== 'nophone') msg = '⚠️ לא נמצא טלפון לנציג' + (repName ? ' \"' + repName + '\"' : '') + ' - ההודעה עברה אליך:\\n\\n' + msg;\nconst st = stamp(at || Date.now());\nconst sheetBody = hit ? JSON.stringify({valueInputOption: 'RAW', data: [\n  {range: \"'\" + hit.tab + \"'!AC1\", values: [['ללא מענה']]},\n  {range: \"'\" + hit.tab + \"'!AC\" + hit.row, values: [['ללא מענה ' + st + (count > 3 ? ' (פעם ' + count + ') - לטיפול נציג' : ' - נשלחה הודעת תיאום ללקוח (' + count + '/3)')]]}\n]}) : '';\nconst first = name.split(' ')[0];\nreturn {action, count, custNum, wa, phone, name, first, repName, repWa, msg, sheetBody, hasRow: !!hit,\n  history: (String(input.prevHistory || '') + ' | ' + st + ' ללא מענה').replace(/^ \\| /, '')};\n"
    },
