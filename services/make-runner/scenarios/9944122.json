     "codeEditorJavascript": "// input.msgs = Graph messages (value array)\nconst items = [];\nfor (const m of (input.msgs || [])) {\n  const from = String(((m.from || {}).emailAddress || {}).address || '').toLowerCase();\n  if (!from.endsWith('pelephone.co.il')) continue;\n  const subj = String(m.subject || '');\n  const num = (subj.match(/(?<!\\d)(\\d{5,9})(?!\\d)/) || [])[1];\n  if (!num) continue;\n  let pv = String(m.bodyPreview || '');\n  pv = pv.split(/בברכה|From:|מאת:/)[0];\n  if (!/ללא\\s*מענה|אין\\s*מענה|לא\\s*ענה|לא\\s*עונה|לא\\s*זמין|לא\\s*השגנו|לא\\s*הצלחנו\\s*להשיג/.test(pv)) continue;\n  items.push({custNum: num, at: String(m.receivedDateTime || ''), text: pv.replace(/\\s+/g, ' ').trim().slice(0, 120), msgId: m.id});\n}\nreturn {count: items.length, items};\n"
    },
