         "dependencies": [],
         "codeEditorJavascript": "const cf={}; for(const f of (input.cf||[])){ if(f && f.name) cf[f.name]=f.value; }\nlet raw=String(input.t1||'').trim(); if(!raw || raw.includes('{{')) raw=String(input.t2||'').trim();\nconst repWa=String(cf['טלפון נציג פלאפון']||'').replace(/\\D/g,'');\nlet phone=String(input.wa||'').replace(/\\D/g,''); if(!phone) phone=String(cf['WA ID']||input.ph||'').replace(/\\D/g,'');\nconst rep=String(cf['שם נציג']||'').trim();\nconst isFollowup=String(cf['תאריך ושעת שיחה']||'').trim()!=='';\nfunction detect(raw){\n  let t=String(raw||'').replace(/\\s+/g,' ').trim();\n  if(!t || t.includes('{{')) return {match:false, reason:'no text'};\n  if(/(הסר|תסיר|תורידו|לא מעוני|לא רלוונטי|תפסיקו|אל תתקשר|לא צריך|לא תודה|לא סלולר|אין צורך|נשאר עם|נשארת עם|נשארים עם|מהעבודה|ממקום העבודה|ממקום עבודה)/.test(t)) return {match:false, reason:'refusal'};\n  const ops=[[/(פרטנר|partner)/i,'פרטנר'],[/(סלקום|cellcom)/i,'סלקום'],[/(הוט ?מובייל|hot ?mobile)/i,'הוט מובייל'],[/(פלא?פון(?!ים)|pelephone)/i,'פלאפון'],[/(גולן|golan)/i,'גולן טלקום'],[/(רמי ?לוי)/,'רמי לוי'],[/(וואלה|walla)/i,'וואלה מובייל'],[/(we ?4g|וי ?פור ?ג|וי4ג|wecom)/i,'WE4G'],[/(אקספון|xphone)/i,'אקספון'],[/(019)/,'019'],[/(012)/,'012 מובייל'],[/(018)/,'018'],[/(ביג ?טוק)/,'ביגטוק'],[/(הוט|hot)/i,'הוט']];\n  const found=[]; for(const [re,l] of ops){ if(re.test(t) && !(l==='הוט' && found.some(f=>f.startsWith('הוט')))) found.push(l); }\n  const words={'אחד':1,'אחת':1,'שניים':2,'שתיים':2,'שתים':2,'שני':2,'שתי':2,'שלוש':3,'שלושה':3,'ארבע':4,'ארבעה':4,'חמש':5,'חמישה':5,'שש':6,'שישה':6,'שבע':7,'שבעה':7,'שמונה':8,'תשע':9,'תשעה':9,'עשר':10,'עשרה':10};\n  const W=Object.keys(words).join('|');\n  const unit='(קווים|קוים|קווי|קו|מנויים|מנוי|סימים|סים|מכשירים|טלפונים|פלאפונים|ניידים)';\n  let count=null, m;\n  m=t.match(new RegExp('(\\\\d{1,2})\\\\s*'+unit)); if(m) count=+m[1];\n  if(count===null){ m=t.match(new RegExp('('+W+')\\\\s*'+unit)); if(m) count=words[m[1]]; }\n  if(count===null){ m=t.match(new RegExp(unit+'\\\\s*(\\\\d{1,2})(?!\\\\d)')); if(m) count=+m[2]; }\n  if(count===null){ m=t.match(new RegExp(unit+'\\\\s*('+W+')')); if(m) count=words[m[2]]; }\n  if(count===null && found.length && t.length<=20 && !/(טלוויז|טלויז|ממיר|מגה|גיגה|שח|ש\"ח|₪)/.test(t)){ m=t.match(/(^|\\D)(\\d{1,2})(\\D|$)/); if(m) count=+m[2]; }\n  if(count!==null && (count<1||count>40)) count=null;\n  const match = count!==null;\n  return {match, count: count===null?'':String(count), operator: found.join(' / '), text: t.slice(0,300), reason: match?'':'no line count'};\n}\nconst d=detect(raw);\nlet match=d.match;\nlet reason=d.reason||'';\nif(match && repWa){ match=false; reason='pelephone sims customer'; }\nif(match && d.operator.includes('פלאפון')){ match=false; reason='already pelephone'; }\nif(match && phone.length<9){ match=false; reason='no phone'; }\nconst rt=String(input.rating||'').trim(); const rec=String(input.rec||'').trim()!==''; let recent=false; { const ms=String(input.sentAt||'').match(/(\\d{4})-(\\d{2})-(\\d{2})/); if(ms){ const nowIL=new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Jerusalem'})); recent=(nowIL-new Date(+ms[1],+ms[2]-1,+ms[3]))/86400000<=8; } }\nif(match && (rt==='5'||rt==='4'||(rec&&recent))){ match=false; reason='post-install rating customer - sent as task to the selling rep'; }\nconst summary=(d.count?d.count+' קווים':'כמות לא צוינה')+' | '+(d.operator||'חברה לא צוינה');\nconst notes='🔥 ליד חם מוואטסאפ: '+summary+'\\nמחובר ל: '+(d.operator||'לא הייציין')+'\\nכמות קווים: '+(d.count||'לא הייציין')+'\\nתשובת הלקוח: \"'+(d.text||'')+'\"'+(rep?('\\nנציג הפולואפ: '+rep):'');\nreturn {match, reason, phone, count:d.count||'', operator:d.operator||'', text:d.text||'', rep, summary, notes};\n"
