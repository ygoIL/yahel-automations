     "codeEditorJavascript": "const rows=(input.values||[]);\nconst seen=new Set();\nconst all=[];\nfor(let i=1;i<rows.length;i++){\n const r=rows[i]||[];\n let p=String(r[0]||'').replace(/\\D/g,'');\n if(p.length===9) p='0'+p;\n if(!/^05\\d{8}$/.test(p) || seen.has(p)) continue;\n seen.add(p);\n const aud=String(r[3]||'');\n const note=String(r[5]||'').trim();\n all.push({phone:p, firstName:String(r[1]||''), lastName:String(r[2]||''), audience:aud, notes: note || ('נתק אותי – '+aud+(r[4]?(' ('+String(r[4]).slice(0,10)+')'):'')), customLeadFields:{}});\n}\nconst batches=[];\nfor(let i=0;i<all.length;i+=200) batches.push({customers: all.slice(i,i+200), idx: batches.length+1, n: Math.min(200, all.length-i)});\nreturn {batches, total: all.length};"
    },
